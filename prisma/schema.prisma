// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  /// Unpooled/direct URL for migrations (required on Neon when DATABASE_URL uses `-pooler`).
  /// Omit in .env only for local Postgres by setting DIRECT_URL to the same value as DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

// ============================================
// Multi-Tenant Workspace Models (ADR-001)
// ============================================

model Workspace {
  id             String   @id @default(cuid())
  name           String
  retentionYears Int      @default(6) // Minimum 5, default 6 (SEC requirement + buffer)
  legalHold      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Billing fields
  billingStatus      BillingStatus  @default(PILOT)
  planTier           PlanTier        @default(FREE)
  billingCurrency    BillingCurrency @default(USD)
  pilotStartDate     DateTime?
  trialStartedAt     DateTime?
  trialEndsAt        DateTime?
  subscriptionStartDate DateTime?
  stripeCustomerId   String?
  stripeSubscriptionId String?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  onboardingType     String?
  onboardingPaidAt   DateTime?

  // Relations
  users       UserWorkspace[]
  meetings    Meeting[]
  auditEvents AuditEvent[]
  invitations Invitation[]
  flags       Flag[]
  resolutionRecords ResolutionRecord[]
  integrationCredentials IntegrationCredential[]
  integrationConfigs    IntegrationConfig[]
  firmProfile           FirmProfile?

  @@index([createdAt])
}

enum BillingStatus {
  PILOT
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum PlanTier {
  FREE
  SOLO
  TEAM
}

enum BillingCurrency {
  USD
  GBP
}

enum WorkspaceRole {
  OWNER_CCO
  MEMBER
  ADVISOR
}

model UserWorkspace {
  userId                 String
  workspaceId            String
  role                   WorkspaceRole
  onboardingDismissedAt  DateTime?
  removedAt              DateTime?
  removedById            String?

  // Relations
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  removedBy User?     @relation("UserWorkspaceRemovedBy", fields: [removedById], references: [id])

  @@id([userId, workspaceId])
  @@index([workspaceId])
  @@index([userId, removedAt])
}

// ============================================
// Meeting Models
// ============================================

enum MeetingStatus {
  UPLOADING
  PROCESSING
  DRAFT_READY
  DRAFT
  ADVISOR_CERTIFIED
  CM_REVIEWED
  CCO_SIGNED_OFF
  FINALIZED
}

enum FinalizeReason {
  COMPLETE_REVIEW
  REQUIRED_CHANGES_ADDRESSED
  EXCEPTION_APPROVED
  OTHER
}

model Meeting {
  id           String        @id @default(cuid())
  workspaceId  String
  clientName   String
  meetingType  String
  meetingDate  DateTime
  status       MeetingStatus @default(UPLOADING)
  fileUrl      String? // S3/R2 storage URL
  sourceFileSha256 String?
  sourceFileName   String?
  sourceFileSize   Int?
  sourceFileMime   String?
  sourceUploadedAt DateTime?
  transcript   Json? // { segments: [{ startTime, endTime, speaker, text }] }
  extraction   Json? // { topics, recommendations, disclosures, decisions, followUps, evidenceMap }
  searchableText String? // Indexed text for fast keyword search (transcript + extracted fields)
  finalizedBy  String? // userId who finalized
  finalizedAt  DateTime? // timestamp when finalized
  finalizeReason FinalizeReason?
  finalizeNote  String?
  finalizedPolicyVersion Int?
  samplingBucket String?
  samplingRuleId String?
  draftReadyAt DateTime? // timestamp when status changed to DRAFT_READY (for KPI tracking)
  timeToFinalize Int? // Time-to-Finalize in seconds (draftReadyAt → finalizedAt) for KPI tracking
  readyForCCO  Boolean  @default(false) // flag indicating meeting is ready for CCO review
  /// Microsoft Graph / SharePoint (Epic 2) — item web URL after auto-deposit
  sharepointItemWebUrl  String?   @db.Text
  sharepointDepositedAt DateTime?
  /// Epic 3 — Zoho CRM: explicit Contact record id; optional when name search is enough
  zohoCrmContactId   String?   @db.Text
  zohoCrmNotePostedAt DateTime?
  advisorCertifiedAt       DateTime?
  advisorCertifiedByUserId String?
  cmReviewedAt             DateTime?
  cmReviewedByUserId       String?
  ccoSignedOffAt           DateTime?
  ccoSignedOffByUserId     String?
  /// Summary counts when CM completes review: { resolved, noted, escalated }
  cmReviewSummary          Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relations
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions    Version[]
  auditEvents AuditEvent[]
  flags       Flag[]
  resolutionRecords ResolutionRecord[]
  integrationSyncLogs IntegrationSyncLog[]
  advisorCertifiedByUser User? @relation("MeetingAdvisorCertifiedBy", fields: [advisorCertifiedByUserId], references: [id], onDelete: SetNull)
  cmReviewedByUser       User? @relation("MeetingCmReviewedBy", fields: [cmReviewedByUserId], references: [id], onDelete: SetNull)
  ccoSignedOffByUser     User? @relation("MeetingCcoSignedOffBy", fields: [ccoSignedOffByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, clientName])
  @@index([workspaceId, meetingDate])
  // Note: searchableText is NOT indexed with btree (too large for index)
  // We use PostgreSQL's native full-text search via to_tsvector() in queries
  // The field is limited to 50KB to prevent database issues
}

model Version {
  id          String   @id @default(cuid())
  meetingId   String
  version     Int // Sequential version number
  editorId    String // userId who made the change
  whatChanged String // Field name and change description
  reason      String? // Optional reason for edit
  timestamp   DateTime @default(now())

  // Relations
  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@index([meetingId, timestamp])
}

// ============================================
// Audit Trail Models (ADR-005)
// ============================================

enum AuditAction {
  UPLOAD
  VIEW
  EDIT
  FINALIZE
  EXPORT
  DELETE
  REMEDIATION_START
  REMEDIATION_UPDATE
  TASK_UPDATE
  EVIDENCE_ADD
  VERIFICATION
  OVERRIDE
  WORKSPACE_CREATED
  INVITE_SENT
  INVITE_RESENT
  INVITE_ACCEPTED
  INVITE_REVOKED
  MEMBER_REMOVED
  ADVISOR_CERTIFIED
  CM_REVIEW_COMPLETED
  CCO_SIGNED_OFF
  WORKFLOW_REVERTED
  DISCLOSURE_SUPPRESSION_ACTIVATED
  DISCLOSURE_SUPPRESSION_DEACTIVATED
  FIRM_PROFILE_APPROVED
}

enum FlagType {
  MISSING_DISCLOSURE
  CONFLICT_LANGUAGE
  MISSING_SUITABILITY_BASIS
}

enum FlagSeverity {
  INFO
  WARN
  CRITICAL
}

enum FlagStatus {
  OPEN
  IN_REMEDIATION
  PENDING_VERIFICATION
  CLOSED
  CLOSED_ACCEPTED_RISK
}

enum FlagResolutionType {
  ADD_CONTEXT
  DISMISSED_WITH_REASON
  DISCLOSED_ELSEWHERE
  FOLLOW_UP_REQUIRED
  OVERRIDE_APPROVED
}

enum RemediationTaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
}

enum EvidenceType {
  TRANSCRIPT_SNIPPET
  DOCUMENT_LINK
  OUTREACH_PROOF
  ACKNOWLEDGEMENT
  NOTE
}

enum VerificationDecision {
  APPROVED
  REJECTED
}

enum FlagCreatedByType {
  SYSTEM
  USER
}

/// Layer-2 triage disposition set by Compliance Manager (three-layer sign-off).
enum CmFlagDisposition {
  NONE
  RESOLVED
  NOTED
  ESCALATED
}

model Flag {
  id            String      @id @default(cuid())
  workspaceId   String
  meetingId     String
  type          FlagType
  severity      FlagSeverity @default(WARN)
  status        FlagStatus   @default(OPEN)
  evidence      Json?
  createdByType FlagCreatedByType @default(SYSTEM)
  createdByUserId String?
  resolvedByUserId String?
  resolvedAt    DateTime?
  resolutionType FlagResolutionType?
  resolutionNote String?
  /// CM triage (resolve / note / escalate) for three-layer workflow.
  cmDisposition    CmFlagDisposition @default(NONE)
  escalationReason String?           @db.Text
  cmTriageNote     String?           @db.Text
  cmTriagedAt      DateTime?
  cmTriagedByUserId String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  meeting   Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  resolutionRecord ResolutionRecord?
  cmTriagedByUser  User?    @relation("FlagCmTriagedBy", fields: [cmTriagedByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([workspaceId, meetingId])
  @@index([workspaceId, status])
  @@index([meetingId, type])
}

model ResolutionRecord {
  id             String   @id @default(cuid())
  workspaceId    String
  meetingId      String
  flagId         String   @unique
  resolutionType FlagResolutionType
  rationale      String
  metadata       Json?
  createdByUserId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  submittedForVerificationAt DateTime?
  closedAt       DateTime?
  closedByUserId String?
  overrideReason String?
  overrideCategory String?

  flag      Flag      @relation(fields: [flagId], references: [id], onDelete: Cascade)
  meeting   Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     ActionItem[]
  evidence  EvidenceLink[]
  verifications Verification[]

  @@index([workspaceId])
  @@index([meetingId])
}

model ActionItem {
  id            String   @id @default(cuid())
  resolutionId  String
  title         String
  status        RemediationTaskStatus @default(OPEN)
  ownerId       String
  dueDate       DateTime
  required      Boolean  @default(true)
  completionNote String?
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  resolution ResolutionRecord @relation(fields: [resolutionId], references: [id], onDelete: Cascade)
  evidence EvidenceLink[]

  @@index([resolutionId])
  @@index([ownerId])
  @@index([dueDate])
}

model EvidenceLink {
  id            String   @id @default(cuid())
  resolutionId  String
  taskId        String?
  type          EvidenceType
  label         String?
  url           String?
  metadata      Json?
  createdByUserId String
  createdAt     DateTime @default(now())

  resolution ResolutionRecord @relation(fields: [resolutionId], references: [id], onDelete: Cascade)
  task      ActionItem? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([resolutionId])
  @@index([taskId])
}

model Verification {
  id            String   @id @default(cuid())
  resolutionId  String
  reviewerId    String
  decision      VerificationDecision
  note          String?
  decidedAt     DateTime @default(now())

  resolution ResolutionRecord @relation(fields: [resolutionId], references: [id], onDelete: Cascade)

  @@index([resolutionId])
  @@index([reviewerId])
}

model AuditEvent {
  id           String      @id @default(cuid())
  workspaceId  String
  userId       String
  action       AuditAction
  resourceType String // "meeting", "workspace", "user"
  resourceId   String
  metadata     Json? // Additional context (field changed, reason, etc.)
  timestamp    DateTime    @default(now())

  // Relations
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  meeting   Meeting?  @relation(fields: [meetingId], references: [id])
  meetingId String?

  @@index([workspaceId, timestamp])
  @@index([workspaceId, resourceType, resourceId])
  @@index([workspaceId, action])
}

// ============================================
// NextAuth Models (Required for Auth.js v5)
// ============================================

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? // @db.Text
  access_token             String? // @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? // @db.Text
  session_state            String?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  refresh_token_expires_in Int?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // Relations
  accounts   Account[]
  sessions   Session[]
  workspaces UserWorkspace[]
  removedWorkspaceMemberships UserWorkspace[] @relation("UserWorkspaceRemovedBy")
  meetingsAdvisorCertified Meeting[] @relation("MeetingAdvisorCertifiedBy")
  meetingsCmReviewed       Meeting[] @relation("MeetingCmReviewedBy")
  meetingsCcoSignedOff    Meeting[] @relation("MeetingCcoSignedOffBy")
  flagsCmTriaged           Flag[]    @relation("FlagCmTriagedBy")
  invitationsSent          Invitation[] @relation("InvitationsSent")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// Invitation Models
// ============================================

model Invitation {
  id          String        @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole
  token       String        @unique
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime      @default(now())

  // Relations
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("InvitationsSent", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, email]) // One invitation per email per workspace
  @@index([token])
  @@index([workspaceId])
  @@index([email])
}

// ============================================
// Integration Models (Epic 6 — IntegrationHub)
// ============================================

enum IntegrationProvider {
  ZOOM
  TEAMS
  SHAREPOINT
  GOOGLE_DRIVE
  SMARTVAULT
  REDTAIL
  WEALTHBOX
  SALESFORCE
  DOCUSIGN
  RIA_IN_A_BOX
  COMPLYSCI
  SLACK
  TEAMS_BOT
  ZOHO_CRM
}

enum IntegrationStatus {
  CONNECTED
  WARNING_RETRYING
  ERROR_ACTION_REQUIRED
  NOT_CONNECTED
}

model IntegrationCredential {
  id                   String   @id @default(cuid())
  workspaceId          String
  provider            IntegrationProvider
  accessTokenEncrypted String   @db.Text
  refreshTokenEncrypted String? @db.Text
  expiresAt           DateTime?
  scopes              String?  @db.Text // Comma-separated OAuth scopes
  status              IntegrationStatus @default(CONNECTED)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
  @@index([workspaceId])
  @@index([provider, status])
}

model IntegrationConfig {
  id              String   @id @default(cuid())
  workspaceId     String
  provider        IntegrationProvider
  config          Json     // folder paths, channel IDs, CRM settings, etc.
  lastSyncAt      DateTime?
  lastErrorAt     DateTime?
  lastErrorMessage String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  syncLogs  IntegrationSyncLog[]

  @@unique([workspaceId, provider])
  @@index([workspaceId])
}

model IntegrationSyncLog {
  id                 String   @id @default(cuid())
  integrationConfigId String?
  meetingId          String?
  provider           IntegrationProvider
  action             String   // note, upload, envelope, etc.
  status             String   // pending, success, failed
  attempts           Int      @default(0)
  errorMessage       String?  @db.Text
  createdAt          DateTime @default(now())
  completedAt       DateTime?

  integrationConfig IntegrationConfig? @relation(fields: [integrationConfigId], references: [id], onDelete: SetNull)
  meeting           Meeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  @@index([integrationConfigId])
  @@index([meetingId])
  @@index([provider, status])
  @@index([createdAt])
}

// ============================================
// Compliance Cockpit — Firm Disclosure Profile (Epic 8.0)
// ============================================

enum DisclosureCategoryStatus {
  ACTIVE
  SUPPRESSING
  NEVER_SUPPRESS
}

enum FirmProfileStatus {
  DRAFT
  ACTIVE
}

enum FirmProfileVersionType {
  INITIAL_SETUP
  APPROVED
}

enum SuppressionAction {
  ACTIVATED
  DEACTIVATED
}

model FirmProfile {
  id               String            @id @default(cuid())
  workspaceId      String            @unique
  status           FirmProfileStatus @default(DRAFT)
  crdNumber        String?
  ccoName          String?
  advFilingDate    DateTime?
  aumUsd           Decimal?
  advDocumentUrl   String?
  advDocumentKey   String?
  riskFlags        String[]
  setupCompletedAt DateTime?
  approvedAt       DateTime?
  approvedByUserId String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?

  workspace            Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  disclosureCategories DisclosureCategory[]
  suppressionLogs      SuppressionLogEntry[]
  versions             FirmProfileVersion[]

  @@index([workspaceId])
}

model DisclosureCategory {
  id                  String                   @id @default(cuid())
  firmProfileId       String
  slug                String
  status              DisclosureCategoryStatus @default(ACTIVE)
  suppressionEvidence String?
  advItemRef          String?
  advPage             Int?
  description         String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  firmProfile FirmProfile @relation(fields: [firmProfileId], references: [id], onDelete: Cascade)

  @@unique([firmProfileId, slug])
  @@index([firmProfileId])
}

model SuppressionLogEntry {
  id               String                    @id @default(cuid())
  workspaceId      String
  firmProfileId    String
  categorySlug     String
  userId           String
  meetingId        String?
  action           SuppressionAction
  previousStatus   DisclosureCategoryStatus?
  newStatus        DisclosureCategoryStatus
  evidenceSnapshot String?
  createdAt        DateTime                  @default(now())

  firmProfile FirmProfile @relation(fields: [firmProfileId], references: [id], onDelete: Cascade)

  @@index([firmProfileId, createdAt])
  @@index([workspaceId, createdAt])
}

model FirmProfileVersion {
  id               String                 @id @default(cuid())
  firmProfileId    String
  workspaceId      String
  versionType      FirmProfileVersionType
  approvedByUserId String?
  approvedAt       DateTime               @default(now())
  snapshot         Json

  firmProfile FirmProfile @relation(fields: [firmProfileId], references: [id], onDelete: Cascade)

  @@index([firmProfileId, approvedAt])
  @@index([workspaceId])
}

// ============================================
// Lead/Trial Request Models
// ============================================

model Lead {
  id        String   @id @default(cuid())
  email     String
  name      String?
  company   String?
  source    String?  // Marketing source (e.g., "complyvault.co", "complyvault.co/uk")
  ipAddress String?
  createdAt DateTime @default(now())

  @@unique([email]) // One lead per email (prevent duplicates)
  @@index([email])
  @@index([createdAt])
}
